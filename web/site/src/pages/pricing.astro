---
import Base from '../layouts/Base.astro';
import { cadLabel, PLANS } from '../lib/plans.js';

const tiers = [
  ...PLANS.live.map((plan) => ({
    name: plan.name,
    price: cadLabel(plan.cad_cents),
    limit: `${plan.calculations.toLocaleString('en-CA')} live calculations / month`,
    blurb: plan.blurb,
  })),
  {
    name: PLANS.test.name,
    price: cadLabel(PLANS.test.cad_cents),
    limit: 'unlimited test calculations',
    blurb: 'np_test_ keys. Identical output to live. Unmetered.',
  },
];
---

<Base title="Pricing — Takehome" engine={false}>
  <article class="prose">
    <h1>Pricing</h1>
    <p class="lede">
      Published CAD prices. Sign up, verify your email, make a call. Test keys
      run the same engine and are not metered. Live keys hard-stop at the plan
      limit — Takehome does not surprise-bill.
    </p>

    <ul class="plans">
      {
        tiers.map((tier) => (
          <li class="plan">
            <h2 class="plan-name">{tier.name}</h2>
            <p class="plan-price">{tier.price}</p>
            <p class="plan-limit">{tier.limit}</p>
            <p class="plan-for">{tier.blurb}</p>
            <p class="cta">
              <a href="/signup/">Get API keys</a>
            </p>
          </li>
        ))
      }
    </ul>

    <p>
      Quebec is not calculated and is not billed. A <code>QC</code> request
      returns <code>jurisdiction_not_supported</code>.
    </p>
    <p>
      Paid tiers are Stripe Checkout in CAD after you have a live key:
      <code>POST /v1/billing/checkout</code> with <code>starter</code>,
      <code>growth</code>, or <code>business</code>. There is no sales queue.
    </p>
  </article>
</Base>
