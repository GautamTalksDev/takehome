---
import Base from '../../layouts/Base.astro';
---

<Base title="Sign up: Takehome" engine={false}>
  <article class="prose">
    <h1>Sign up</h1>
    <p class="lede">
      Email, verify, keys, first call. No sales call. No onboarding. No demo
      request.
    </p>
    <form id="signup-form" method="post" action="#">
      <label>
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <button type="submit">Get a verification link</button>
    </form>
    <p id="signup-status" role="status"></p>
    <p id="signup-verify-wrap" hidden>
      <a id="signup-verify" href="#">Open the verification link</a>
    </p>
    <p>
      After you verify, you get an <code>np_test_</code> key and an{' '}
      <code>np_live_</code> key. The first call is on{' '}
      <a href="/docs/">Docs</a>. Prices are on{' '}
      <a href="/pricing/">pricing</a>.
    </p>
  </article>
  <script is:inline type="module" src="/scripts/signup.js"></script>
</Base>
